# Copy to `.env` and fill in. `.env` is gitignored.

# --- Mailing list (existing /api/subscribe endpoint) ---
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_SERVER_PREFIX=us1

# --- Robinhood trading console (/trading) ---
# Bearer token for the Robinhood trading MCP agent. Required to connect.
# Read only on the server; never exposed to the browser.
ROBINHOOD_MCP_TOKEN=
# Optional override; defaults to the official endpoint below.
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
# Shared passphrase that gates the /trading console. When set, the page prompts
# for it and the server requires it before any trading action. Leave unset to
# disable the gate (the console then warns that it is open).
TRADING_PASSCODE=
